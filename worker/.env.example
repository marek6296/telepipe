# Telepipe worker — environment variables (see src/config.py Config.from_env
# for the source of truth). Copy to .env and fill in real values; .env is
# gitignored and must never be committed.

# --- Supabase (required) ---
# telepipe project (cggsyshfdjycfqrhtjld). Service role key — server-only,
# never expose to a browser/client. Anon key has no RLS policies and can't
# read anything.
SUPABASE_URL=https://cggsyshfdjycfqrhtjld.supabase.co
SUPABASE_SERVICE_KEY=

# --- LLM (required) ---
# Any OpenAI-compatible endpoint (Atlas Cloud, OpenRouter, xAI, ...).
# LLM_API_KEY is the primary name; ATLAS_API_KEY / OPENROUTER_API_KEY are
# accepted as fallbacks for compatibility (first non-empty one wins).
LLM_API_KEY=
# ATLAS_API_KEY=
# OPENROUTER_API_KEY=

# Optional — defaults shown. LLM_BASE_URL defaults to Atlas Cloud.
# LLM_BASE_URL=https://api.atlascloud.ai/v1
# LLM_MODEL / OPENROUTER_MODEL (LLM_MODEL wins) default to xai/grok-4.5
# LLM_MODEL=xai/grok-4.5
# LLM_SUMMARY_MODEL defaults to LLM_MODEL if unset
# LLM_SUMMARY_MODEL=
# LLM_REASONING_EFFORT=low
# LLM_VISION_MODEL=qwen/qwen3-vl-235b-a22b-thinking
# LLM_AUDIO_MODEL=google/gemini-3.5-flash

# --- Voice (optional — custom TTS backend; empty = voice replies disabled, text sent instead) ---
# VOICE_API_URL=
# VOICE_API_KEY=
# VOICE_AMBIENCE=

# --- Behavior defaults (optional — inherited by every tenant unless the
#     behavior table overrides them per-model in a later phase) ---
# CONTEXT_MESSAGES=12
# SUMMARY_EVERY=15
# SKIP_CONTACTS=true
# CONTACT_EXCEPTIONS=            # comma or semicolon separated Telegram ids
# LINK_MIN_MESSAGES=6
# LINK_COOLDOWN_HOURS=48
# LINK_MAX_PUSHES=1

# --- Encryption (required) ---
# AES-256-GCM key for tg_session_enc / control_bot_token_enc, base64-encoded
# 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing/rotating this key makes all stored sessions and bot tokens
# undecryptable — keep it only in Railway env, back it up securely.
ENCRYPTION_KEY=

# --- Multi-tenant worker pool (optional — defaults shown) ---
# How many tenants this replica runs concurrently.
# MAX_TENANTS=25
# How often the claim loop runs (seconds).
# CLAIM_INTERVAL_S=30
# Lease owner identity in models.claimed_by. Railway sets
# RAILWAY_REPLICA_ID automatically; falls back to hostname-pid locally.
# RAILWAY_REPLICA_ID=

# --- Credits (optional — default shown) ---
# Conservative $/M-token charge used when a model is missing from the
# `pricing` table.
# FALLBACK_PRICE_PER_MTOK=5.0

# --- Pricing auto-sync (optional — defaults shown) ---
# Background task (main.py run()) that pulls the last 3 full days of usage
# and cost from the Atlas Cloud Billing Public API (same key as LLM_API_KEY)
# and updates `pricing.input_usd_per_mtok` / `output_usd_per_mtok` for every
# model it sees. Never touches the `multiplier` column or the `_default` row.
# First run happens ~60s after boot, then every PRICING_SYNC_HOURS. 0 = off.
# PRICING_SYNC_HOURS=24
# Below this USD balance, check_atlas_balance() logs an error each cycle so
# it doesn't go unnoticed (Atlas dashboard: https://atlascloud.ai — billing).
# ATLAS_BALANCE_ALERT_USD=50

# --- Fanvue (optional — leave empty to run Telegram only) ---
# The same OAuth app the web uses (redirect https://telepipe.me/api/fanvue/callback).
# The worker needs it to REFRESH the access token; connecting an account happens
# in the web app. Without both values no Fanvue agent is ever started.
# The webhook signing secret lives in the web app only — the worker never sees
# a raw delivery, it reads the already verified `fanvue_events` queue.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=

# --- Logging (optional) ---
# LOG_LEVEL=INFO

# Web, ktorý vystavuje faktúry na Pipe Coiny (control bot si ich pýta cez neho).
WEB_API_URL=https://telepipe.me
INTERNAL_API_SECRET=
