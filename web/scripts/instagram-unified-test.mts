import assert from 'node:assert/strict';
import {authorizeUrl, exchangeCode, profile, instagramConfigured} from '../lib/instagram.ts';
process.env.INSTAGRAM_APP_ID='123';
process.env.INSTAGRAM_APP_SECRET='test-secret';
process.env.INSTAGRAM_CONFIG_ID='456';
const url=new URL(authorizeUrl('https://telepipe.me','csrf'));
assert.equal(url.origin,'https://www.facebook.com');
assert.equal(url.searchParams.get('config_id'),'456');
assert.equal(url.searchParams.get('state'),'csrf');
assert.equal(url.searchParams.get('prompt'),'login');
assert.equal(url.searchParams.has('scope'),false);
delete process.env.INSTAGRAM_CONFIG_ID;
assert.equal(instagramConfigured(),false);
process.env.INSTAGRAM_CONFIG_ID='456';
const requests: string[]=[];
globalThis.fetch=async (input, init)=>{
 const u=new URL(String(input)); requests.push(u.pathname);
 assert.equal(u.origin,'https://graph.facebook.com');
 if(u.pathname.endsWith('/oauth/access_token')) return Response.json({access_token:'test-token',token_type:'bearer'});
 assert.equal(new Headers(init?.headers).get('Authorization'),'Bearer test-token');
 if(u.pathname.endsWith('/assigned_instagram_accounts')) return Response.json({data:[{id:'ig-1',username:'simapussina'}]});
 if(u.searchParams.get('fields')==='client_business_id') return Response.json({client_business_id:'business-1',id:'suat-user'});
 return Response.json({id:'ig-1',username:'simapussina',account_type:'MEDIA_CREATOR'});
};
const token=await exchangeCode('https://telepipe.me','code');
assert.equal(token.expiresIn,0);
const me=await profile(token.accessToken);
assert.equal(me.id,'ig-1');
assert.equal(me.businessId,'business-1');
assert(requests.some(p=>p.endsWith('/assigned_instagram_accounts')));
globalThis.fetch=async()=>Response.json({data:[{id:'one'},{id:'two'}]});
await assert.rejects(()=>profile('test-token'),/one Instagram account/i);
console.log('Unified Login URL, tokens, account discovery and ambiguous selection: OK');
