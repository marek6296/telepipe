# Telepipe web — skopíruj do .env.local a doplň reálne hodnoty.
# Zdroj pravdy pre kľúče je root repa `.env` (gitignored) a Vercel env vars.

# POZOR: všetky NEXT_PUBLIC_* Next staticky vloží do bundlu pri BUILDE, nie za
# behu. Na Verceli teda MUSIA byť nastavené EŠTE PRED buildom — dopísať ich až
# po deployi nezaberie, treba redeploy.

# --- Supabase (verejné, končia v client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# --- Server-only (NIKDY nie NEXT_PUBLIC_, nikdy nie v client bundle) ---
# Service role kľúč — používa sa len v server actions, ktoré si samy overia vlastníctvo
# (napr. zápis do *_enc stĺpcov, na ktoré authenticated nemá grant).
SUPABASE_SERVICE_KEY=<supabase-service-role-key>

# AES-256-GCM kľúč (base64, 32 bajtov) na šifrovanie TG session, api_hash, kódov a
# bot tokenov. MUSÍ byť BAJT NA BAJT identický s ENCRYPTION_KEY workera na Railway —
# inak worker nedešifruje to, čo web zašifroval. Vygenerovanie nového:
#   openssl rand -base64 32
ENCRYPTION_KEY=<base64-32-bytes>

# --- Fanvue (fáza 3) ---
# OAuth appka, ktorú Marek založil v Fanvue creator dashboarde.
#   redirect URI: https://telepipe.me/api/fanvue/callback
#   webhook URL:  https://telepipe.me/api/fanvue/webhook
# Client ID nie je tajomstvo (ide v URL na Fanvue), secret a signing secret áno.
# Rovnaké FANVUE_CLIENT_ID/FANVUE_CLIENT_SECRET potrebuje aj worker na Railway —
# obnovu prístupového tokenu robí on (worker/src/fanvue_api.py).
FANVUE_CLIENT_ID=1aa48b88-8c62-4d01-84ff-4b1839f4fbf6
FANVUE_CLIENT_SECRET=<fanvue-client-secret>
# Signing secret webhooku. Prázdne = každé doručenie sa odmietne (401).
FANVUE_WEBHOOK_SECRET=<fanvue-webhook-signing-secret>
# Nepovinné — keď treba redirect URI natvrdo (lokálny vývoj proti prod appke).
# Musí sedieť ZNAK PO ZNAKU s tým, čo je uložené vo Fanvue appke.
# FANVUE_REDIRECT_URI=https://telepipe.me/api/fanvue/callback

# --- LLM (asistovaná tvorba persony) ---
# Ten istý kľúč a ten istý poskytovateľ ako worker (`worker/src/config.py`).
# Bez neho sa asistent v dashboarde neponúkne — karty sa vypĺňajú ručne.
# Volanie sa meria a účtuje rovnako ako odpoveď modelky: `usage_events`, kind
# 'chat', cena z tabuľky `pricing` × multiplier.
LLM_API_KEY=<atlas-api-key>
# Nepovinné — defaulty sedia s workerom.
# LLM_BASE_URL=https://api.atlascloud.ai/v1
# LLM_MODEL=xai/grok-4.5
# FALLBACK_PRICE_PER_MTOK=5.0

# --- Feature flagy ---
# Google OAuth je zámerne vypnutý až kým Marek nenastaví provider v Supabase.
# Button sa vykreslí, ale je disabled s tooltipom "Available soon".
NEXT_PUBLIC_GOOGLE_AUTH=false

# Absolútna URL pre auth redirecty (email confirm, reset password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
