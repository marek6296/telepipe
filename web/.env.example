# Telepipe web — skopíruj do .env.local a doplň reálne hodnoty.
# Zdroj pravdy pre kľúče je root repa `.env` (gitignored) a Vercel env vars.

# POZOR: všetky NEXT_PUBLIC_* Next staticky vloží do bundlu pri BUILDE, nie za
# behu. Na Verceli teda MUSIA byť nastavené EŠTE PRED buildom — dopísať ich až
# po deployi nezaberie, treba redeploy.

# --- Supabase (verejné, končia v client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# --- Server-only (NIKDY nie NEXT_PUBLIC_, nikdy nie v client bundle) ---
# Service role kľúč — používa sa len v server actions, ktoré si samy overia vlastníctvo
# (napr. zápis do *_enc stĺpcov, na ktoré authenticated nemá grant).
SUPABASE_SERVICE_KEY=<supabase-service-role-key>

# AES-256-GCM kľúč (base64, 32 bajtov) na šifrovanie TG session, api_hash, kódov a
# bot tokenov. MUSÍ byť BAJT NA BAJT identický s ENCRYPTION_KEY workera na Railway —
# inak worker nedešifruje to, čo web zašifroval. Vygenerovanie nového:
#   openssl rand -base64 32
ENCRYPTION_KEY=<base64-32-bytes>

# --- Feature flagy ---
# Google OAuth je zámerne vypnutý až kým Marek nenastaví provider v Supabase.
# Button sa vykreslí, ale je disabled s tooltipom "Available soon".
NEXT_PUBLIC_GOOGLE_AUTH=false

# Absolútna URL pre auth redirecty (email confirm, reset password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
